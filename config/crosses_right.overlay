#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

&trackball_central {
    cpi = <400>;
};

/ {
    input_processors {
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };
};

&zip_temp_layer {
    excluded-positions = <
        12 // D / RCLK
        13 // F / LCLK
        14 // G / MB5
        24 // B / MB4
        32 // Left thumb Shift / MCLK
    >;
    require-prior-idle-ms = <300>;
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;
    input-processors = <
        &zip_ble_report_rate_limit
        &zip_temp_layer 2 4000
    >;

    sniper_override {
        layers = <4>;
        input-processors = <
            &zip_xy_scaler 1 3
        >;
    };

    scroll_override {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_scaler 1 4
            &zip_scroll_x_scaler 0 1
        >;
    };
};

&trackball_peripheral_listener {
    status = "okay";
    input-processors = <
        &zip_xy_to_scroll_mapper
        &zip_scroll_scaler 1 4
        &zip_scroll_x_scaler 0 1
        &zip_ble_report_rate_limit
    >;

    left_horizontal_scroll_override {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_scaler 0 1
            &zip_scroll_x_scaler 1 4
            &zip_ble_report_rate_limit
        >;
    };
};
