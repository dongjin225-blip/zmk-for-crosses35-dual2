#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

&trackball_central {
    cpi = <400>; // 오른쪽 트랙볼 커서 속도. 빠르면 300, 느리면 600 정도로 조절.
};

/ {
    input_processors {
        /*
         * 오른쪽 트랙볼 -15도 보정.
         *
         * 증상:
         * - 좌에서 우로 굴리면 커서가 아래로 같이 내려감.
         *
         * 원리:
         * - X/Y 이동값을 작은 각도로 회전시켜서 센서가 비스듬히 박힌 것을 보정.
         * - cos-milli/sin-milli는 삼각함수 값에 1000을 곱한 정수임.
         * - -15도 기준 cos=0.966, sin magnitude=0.259라서 <966>, <259> 사용.
         *
         * 튜닝:
         * - 아직 아래로 내려가면 sin-milli를 더 크게: <300>, <350>
         * - 반대로 위로 올라가면 0에 가깝게: <220>, <180>
         */
        right_trackball_rotate: right_trackball_rotate {
            compatible = "zmk,input-processor-rotate";
            status = "okay";
            #input-processor-cells = <0>;
            cos-milli = <966>;
            sin-milli = <259>;
            track-remainders;
        };

        // 가로 스크롤 전용 scaler.
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        // 세로 스크롤 전용 scaler.
        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/*
 * 오른쪽 트랙볼을 움직이면 2번 Mouse 레이어로 자동 진입.
 *
 * excluded-positions는 Mouse 레이어가 켜진 상태에서 눌러도
 * 오토마우스 레이어가 꺼지면 안 되는 키 목록임.
 */
&zip_temp_layer {
    excluded-positions = <
        10
        1
        2
        3
        5
        0
        24
        30
        31
        32
    >;

    require-prior-idle-ms = <100>;
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    input-processors = <
        &right_trackball_rotate
        &zip_ble_report_rate_limit
        &zip_temp_layer 2 1000
    >;

    sniper_override {
        layers = <4>;
        input-processors = <
            &right_trackball_rotate
            &zip_xy_scaler 1 3
        >;
    };

    scroll_override {
        layers = <3>;
        input-processors = <
            &right_trackball_rotate
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_y_scaler 1 4
            &zip_scroll_x_scaler 0 1
        >;
    };
};

&trackball_peripheral_listener {
    status = "okay";
    input-processors = <
        &zip_xy_to_scroll_mapper
        &zip_scroll_y_scaler 1 8
        &zip_scroll_x_scaler 0 1
        &zip_ble_report_rate_limit
    >;

    left_horizontal_scroll_override {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_y_scaler 0 1
            &zip_scroll_x_scaler 1 8
            &zip_ble_report_rate_limit
        >;
    };
};
