#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

&trackball_central {
    cpi = <400>; // 오른쪽 트랙볼 커서 속도
};

/ {
    input_processors {
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };
};

// 오토마우스 레이어 자동 이탈 설정
&zip_temp_layer {
    excluded-positions = <
        12 // D / RCLK
        13 // F / LCLK
        14 // G / MB5
        24 // B / MB4
        32 // Left thumb Shift / MCLK
    >;
    require-prior-idle-ms = <300>; // 키 입력 직후 오토마우스 오작동 방지
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;
    input-processors = <
        &zip_ble_report_rate_limit
        &zip_temp_layer 2 4000 // 오른쪽 트랙볼 움직이면 2번 Mouse 레이어 자동 진입
    >;

    sniper_override {
        layers = <4>; // 4번 레이어에서 오른쪽 트랙볼 감속
        input-processors = <
            &zip_xy_scaler 1 3 // 포인팅 속도 1/3
        >;
    };

    scroll_override {
        layers = <3>; // 3번 레이어에서 오른쪽 트랙볼 세로 스크롤
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT // 세로 스크롤 방향 반전
            &zip_scroll_scaler 1 4 // 세로 스크롤 속도
            &zip_scroll_x_scaler 0 1 // 오른쪽 트랙볼 가로 스크롤 제한
        >;
    };
};

&trackball_peripheral_listener {
    status = "okay";
    input-processors = <
        &zip_xy_to_scroll_mapper
        &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
        &zip_scroll_scaler 1 4 // 평소 왼쪽 트랙볼 세로 스크롤 속도
        &zip_scroll_x_scaler 0 1 // 평소 왼쪽 트랙볼 가로 스크롤 제한
        &zip_ble_report_rate_limit
    >;

    left_horizontal_scroll_override {
        layers = <3>; // 3번 레이어에서 왼쪽 트랙볼 가로 스크롤
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_scaler 0 1 // 3번 레이어에서 왼쪽 트랙볼 세로 스크롤 제한
            &zip_scroll_x_scaler 1 4 // 3번 레이어에서 왼쪽 트랙볼 가로 스크롤 속도
            &zip_ble_report_rate_limit
        >;
    };
};
