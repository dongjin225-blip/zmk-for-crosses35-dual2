#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

&trackball_central {
    cpi = <400>; // 오른쪽 트랙볼 커서 속도. 빠르면 300, 느리면 600 정도로 조절.
};

/ {
    input_processors {
        // 가로 스크롤 전용 scaler.
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        // 세로 스크롤 전용 scaler.
        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

// 오른쪽 트랙볼을 움직였을 때 2번 Mouse 레이어를 자동으로 켜는 설정.
// excluded-positions에 들어간 키는 Mouse 레이어가 켜진 상태에서 눌러도 레이어가 바로 꺼지지 않음.
//
// 현재 Mouse 레이어 기준:
// 1  = W / MCLK
// 2  = E / RCLK, MB4 콤보 재료
// 3  = R / LCLK, MB5 콤보 재료
// 5  = Y / LCLK, MB4/MB5 콤보 재료
// 30 = 좌측 엄지 / LEFT_ALT
// 31 = 좌측 엄지 / LCTRL
// 32 = 좌측 엄지 / LEFT_SHIFT
&zip_temp_layer {
    excluded-positions = <
        1  // W / MCLK
        2  // E / RCLK, MB4 combo
        3  // R / LCLK, MB5 combo
        5  // Y / LCLK, MB4/MB5 combo
        30 // Left thumb / LEFT_ALT
        31 // Left thumb / LCTRL
        32 // Left thumb / LEFT_SHIFT
    >;
    require-prior-idle-ms = <100>;
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;
    input-processors = <
        &zip_ble_report_rate_limit
        &zip_temp_layer 2 4000 // 오른쪽 트랙볼 움직이면 2번 Mouse 레이어 자동 진입, 4초 후 해제
    >;

    sniper_override {
        layers = <4>;
        input-processors = <
            &zip_xy_scaler 1 3
        >;
    };

    scroll_override {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_y_scaler 1 4
            &zip_scroll_x_scaler 0 1
        >;
    };
};

&trackball_peripheral_listener {
    status = "okay";
    input-processors = <
        &zip_xy_to_scroll_mapper
        &zip_scroll_y_scaler 1 4
        &zip_scroll_x_scaler 0 1
        &zip_ble_report_rate_limit
    >;

    left_horizontal_scroll_override {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_y_scaler 0 1
            &zip_scroll_x_scaler 1 4
            &zip_ble_report_rate_limit
        >;
    };
};
