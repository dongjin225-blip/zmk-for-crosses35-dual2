#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors/runtime-input-processor.dtsi>

&trackball_central {
    cpi = <400>; // 오른쪽 트랙볼 커서 속도. 빠르면 300, 느리면 600 정도로 조절.
};

/ {
    input_processors {
        /*
         * 오른쪽 트랙볼 각도 보정.
         *
         * 증상:
         * - 좌에서 우로 굴리면 커서가 아래로 같이 내려감.
         *
         * 보정:
         * - 출력 벡터가 오른쪽+아래로 기울어진 상태라
         *   반시계 방향으로 -15도 돌려서 수평에 가깝게 맞춤.
         *
         * 튜닝:
         * - 아직 아래로 내려가면 -20, -25처럼 더 음수로.
         * - 반대로 위로 올라가면 -10, -5처럼 0에 가깝게.
         */
        right_trackball_rotate_15: right_trackball_rotate_15 {
            compatible = "zmk,input-processor-runtime";
            processor-label = "rball15";

            type = <INPUT_EV_REL>;
            x-codes = <INPUT_REL_X>;
            y-codes = <INPUT_REL_Y>;

            scale-multiplier = <1>;
            scale-divisor = <1>;

            rotation-degrees = <-15>;

            active-layers = <0>; // 모든 레이어에서 적용.
            track-remainders;

            #input-processor-cells = <0>;
        };

        // 가로 스크롤 전용 scaler.
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        // 세로 스크롤 전용 scaler.
        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/*
 * 오른쪽 트랙볼을 움직이면 2번 Mouse 레이어로 자동 진입.
 *
 * excluded-positions는 Mouse 레이어가 켜진 상태에서 눌러도
 * 오토마우스 레이어가 꺼지면 안 되는 키 목록임.
 */
&zip_temp_layer {
    excluded-positions = <
        10
        1
        2
        3
        5
        0
        24
        30
        31
        32
    >;

    require-prior-idle-ms = <100>;
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    input-processors = <
        &right_trackball_rotate_15
        &zip_ble_report_rate_limit
        &zip_temp_layer 2 1000
    >;

    sniper_override {
        layers = <4>;
        input-processors = <
            &right_trackball_rotate_15
            &zip_xy_scaler 1 3
        >;
    };

    scroll_override {
        layers = <3>;
        input-processors = <
            &right_trackball_rotate_15
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_y_scaler 1 4
            &zip_scroll_x_scaler 0 1
        >;
    };
};

&trackball_peripheral_listener {
    status = "okay";
    input-processors = <
        &zip_xy_to_scroll_mapper
        &zip_scroll_y_scaler 1 8
        &zip_scroll_x_scaler 0 1
        &zip_ble_report_rate_limit
    >;

    left_horizontal_scroll_override {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_y_scaler 0 1
            &zip_scroll_x_scaler 1 8
            &zip_ble_report_rate_limit
        >;
    };
};
