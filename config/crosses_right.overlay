#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>

&trackball_central {
    cpi = <400>; // 오른쪽 트랙볼 커서 속도. 빠르면 300, 느리면 600 정도로 조절.
};

/ {
    input_processors {
        // 가로 스크롤 전용 scaler.
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        // 세로 스크롤 전용 scaler.
        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/*
 * 오른쪽 트랙볼을 움직이면 2번 Mouse 레이어로 자동 진입.
 *
 * excluded-positions는 Mouse 레이어가 켜진 상태에서 눌러도
 * 오토마우스 레이어가 꺼지면 안 되는 키 목록임.
 *
 * 현재 Mouse 레이어 기준:
 * 10  = A 자리 / LEFT_SHIFT
 * 1  = W 자리 / MCLK
 * 2  = E 자리 / RCLK, MB4 콤보 재료
 * 3  = R 자리 / LCLK, MB5 콤보 재료
 * 5  = Y 자리 / LCLK, MB4/MB5 콤보 재료
 * 0 = Q 자리 / LALT
 * 24 = B 자리 / LCTRL
 * 30 = 좌측 엄지 / LEFT_ALT
 * 31 = 좌측 엄지 / LCTRL
 * 32 = 좌측 엄지 / LEFT_SHIFT
 */
&zip_temp_layer {
    excluded-positions = <
        10
        1
        2
        3
        5
        0
        24
        30
        31
        32
    >;

    require-prior-idle-ms = <100>;
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    input-processors = <
        &zip_ble_report_rate_limit
        &zip_temp_layer 2 4000
    >;

    sniper_override {
        layers = <4>;
        input-processors = <
            &zip_xy_scaler 1 3
        >;
    };

    scroll_override {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_y_scaler 1 4
            &zip_scroll_x_scaler 0 1
        >;
    };
};

&trackball_peripheral_listener {
    status = "okay";
    input-processors = <
        &zip_xy_to_scroll_mapper
        &zip_scroll_y_scaler 1 8
        &zip_scroll_x_scaler 0 1
        &zip_ble_report_rate_limit
    >;

    left_horizontal_scroll_override {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_y_scaler 0 1
            &zip_scroll_x_scaler 1 8
            &zip_ble_report_rate_limit
        >;
    };
};
