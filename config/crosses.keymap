#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hm: my_homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_HOMEROW_MOD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
        };

        hml: hmlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "Home_ROW_Layer";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <130>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc_del {
            bindings = <&hm DEL ESC>;
            key-positions = <0 1>;
        };

        exclam {
            bindings = <&kp LS(NUMBER_1)>;
            key-positions = <15 16>;
        };

        slash_quet {
            bindings = <&kp RS(SLASH)>;
            key-positions = <25 16>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <1 2>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <3 2>;
        };

        mclk_left {
            bindings = <&mkp MCLK>;
            key-positions = <14 15>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <13 12>;
        };

        prev_left {
            bindings = <&mkp MB4>;
            key-positions = <13 11>;
        };

        backspace_right {
            bindings = <&kp BSPC>;
            key-positions = <16 17>;
        };

        enter_right {
            bindings = <&kp ENTER>;
            key-positions = <17 18>;
        };

        del_right {
            bindings = <&kp DEL>;
            key-positions = <18 16>;
        };

        brace {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <8 9>;
        };

        braceL {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <9 8 17>;
        };

        tap {
            bindings = <&kp TAB>;
            key-positions = <13 2>;
        };

        tride {
            bindings = <&kp TILDE>;
            key-positions = <11 2>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <16 7>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <24 13>;
        };

        capture {
            bindings = <&kp LG(LS(S))>;
            key-positions = <4 3>;
        };

        volumeup {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <0 9>;
        };

        volumedown {
            bindings = <&kp C_VOLUME_DOWN>;
            key-positions = <19 10>;
        };

        cst {
            bindings = <&kp LC(LS(T))>;
            key-positions = <4 24>;
        };

        csd {
            bindings = <&kp LC(LS(D))>;
            key-positions = <24 12>;
        };

        p {
            bindings = <&kp P>;
            key-positions = <14 13>;
        };

        f {
            bindings = <&kp NUMBER_4>;
            key-positions = <14 3>;
        };
    };

    macros {
        dj: dj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp O &kp P &kp STAR &kp N6 &kp N4 &kp N3 &kp N5 &kp N1 &kp N8 &kp RET>;
            label = "DJ";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q        &kp W        &kp E        &hm LEFT_ALT R    &kp T        &kp Y     &kp U              &kp I        &kp O            &kp P
&kp A        &kp S        &kp D        &hm LEFT_SHIFT F  &hml 4 G     &hml 3 H  &hm RIGHT_SHIFT J  &hm RCTRL K  &hm RIGHT_ALT L  &hm SEMICOLON SQT
&hm LC(Z) Z  &hm LC(X) X  &hm LC(C) C  &hm LC(V) V       &hm LCTRL B  &kp N     &kp M              &kp COMMA    &kp DOT          &kp ENTER
                          &kp LGUI     &mo 6             &mo 1        &mo 1     &trans             &kp LGUI
            >;
        };

        Num_layer {
            display-name = "Num";
            bindings = <
&trans       &kp F7  &kp F8  &kp F9  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans
&dj          &kp F4  &kp F5  &kp F6  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&bootloader  &kp F1  &kp F2  &kp F3  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &bootloader
                     &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans     &trans     &trans     &mkp LCLK  &trans  &trans  &trans  &trans
&trans  &trans  &mkp RCLK  &mkp LCLK  &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans     &trans  &trans  &trans  &trans
                &trans     &trans     &mkp MCLK  &trans     &trans  &trans
            >;
        };

        Scroll_Layrer {
            bindings = <
&trans    &kp UP    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans     &trans  &trans  &trans  &trans  &trans
            >;
        };

        Snipe_Layer {
            bindings = <
&trans    &kp UP    &trans     &trans  &trans  &trans    &trans    &trans     &trans  &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans    &kp UP    &trans     &trans  &trans
&trans    &trans    &trans     &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
                    &trans     &trans  &trans  &trans    &trans    &trans
            >;

            label = "Snipe";
        };

        BT_Layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans  &trans  &trans  &trans  &trans
            >;

            label = "BT";
        };

        arrow {
            bindings = <
&trans  &trans          &kp UP_ARROW    &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans          &trans     &trans  &trans  &trans  &trans  &trans  &trans
                        &trans          &trans     &trans  &trans  &trans  &trans
            >;
        };
    };
};
