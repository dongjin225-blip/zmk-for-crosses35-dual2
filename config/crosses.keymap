#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hm: my_homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_HOMEROW_MOD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "tap-preferred";
        };

        hml: hmlayer {
            compatible = "zmk,behavior-hold-tap";
            label = "Home_ROW_Layer";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <130>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc_del {
            bindings = <&hm DEL ESC>;
            key-positions = <0 1>;
        };

        exclam {
            bindings = <&kp LS(NUMBER_1)>;
            key-positions = <15 16>;
        };

        slash_quet {
            bindings = <&kp RS(SLASH)>;
            key-positions = <25 16>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <1 2>;
            layers = <0 2>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <3 2>;
            layers = <0 2>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <13 12>;
        };

        enter_left {
            bindings = <&kp ENTER>;
            key-positions = <11 12>;
        };

        backspace_right {
            bindings = <&kp BSPC>;
            key-positions = <16 17>;
        };

        enter_right {
            bindings = <&kp ENTER>;
            key-positions = <17 18>;
        };

        back_left {
            bindings = <&kp BACKSPACE>;
            key-positions = <13 22>;
        };

        brace {
            bindings = <&hm RIGHT_BRACKET RIGHT_PARENTHESIS>;
            key-positions = <8 9>;
        };

        braceL {
            bindings = <&hm LEFT_BRACKET LEFT_PARENTHESIS>;
            key-positions = <8 17>;
        };

        tap {
            bindings = <&kp TAB>;
            key-positions = <13 2>;
        };

        tride {
            bindings = <&kp GRAVE>;
            key-positions = <11 2>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <16 7>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <24 13>;
        };

        capture {
            bindings = <&kp LG(LS(S))>;
            key-positions = <4 3>;
        };

        volumeup {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <27 26>;
        };

        volumedown {
            bindings = <&kp C_VOLUME_DOWN>;
            key-positions = <25 26>;
        };

        csd {
            bindings = <&kp LC(LS(D))>;
            key-positions = <24 12>;
        };

        p {
            bindings = <&kp P>;
            key-positions = <14 13>;
        };

        f {
            bindings = <&kp NUMBER_4>;
            key-positions = <3 24>;
        };

        preview {
            bindings = <&mkp MB5>;
            key-positions = <3 25>;
        };

        beforef {
            bindings = <&mkp MB4>;
            key-positions = <2 25>;
        };

        wintab {
            bindings = <&kp LG(TAB)>;
            key-positions = <2 13 24>;
        };

        capslock {
            bindings = <&kp CAPS>;
            key-positions = <10 11>;
        };

        mute {
            bindings = <&kp C_MUTE>;
            key-positions = <27 25>;
        };

        n3 {
            bindings = <&kp NUMBER_3>;
            key-positions = <24 2>;
        };

        n2 {
            bindings = <&kp NUMBER_2>;
            key-positions = <24 1>;
        };

        n1 {
            bindings = <&kp NUMBER_1>;
            key-positions = <24 0>;
        };

        n5 {
            bindings = <&kp N5>;
            key-positions = <24 4>;
        };

        n6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <25 5>;
        };

        n7 {
            bindings = <&kp N7>;
            key-positions = <25 6>;
        };

        n8 {
            bindings = <&kp N8>;
            key-positions = <25 7>;
        };

        n9 {
            bindings = <&kp N9>;
            key-positions = <25 8>;
        };

        n0 {
            bindings = <&kp N0>;
            key-positions = <25 9>;
        };

        batang {
            bindings = <&kp LG(D)>;
            key-positions = <4 3 24>;
        };

        n6_l {
            bindings = <&kp NUMBER_6>;
            key-positions = <23 0>;
        };

        n7_l {
            bindings = <&kp N7>;
            key-positions = <23 1>;
        };

        n8_l {
            bindings = <&kp N8>;
            key-positions = <23 2>;
        };

        n9_l {
            bindings = <&kp N9>;
            key-positions = <3 23>;
        };

        n0_l {
            bindings = <&kp N0>;
            key-positions = <23 4>;
        };

        file {
            bindings = <&kp C_AL_FILES>;
            key-positions = <4 3 23>;
        };

        altf4 {
            bindings = <&kp LA(F4)>;
            key-positions = <2 3 24>;
        };
    };

    macros {
        dj: dj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp O &kp P &kp STAR &kp N6 &kp N4 &kp N3 &kp N5 &kp N1 &kp N8 &kp RET>;
            label = "DJ";
        };

        dj2: dj2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_3 &kp N5 &kp NUMBER_1 &kp NUMBER_8>;
            label = "DJ2";
        };

        sleep: sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp U &kp S>;
            label = "SLEEP";
            wait-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q        &kp W        &kp E        &kp R             &hm LEFT_ALT T  &kp Y     &kp U              &kp I        &kp O            &kp P
&kp A        &kp S        &kp D        &hm LEFT_SHIFT F  &hml 4 G        &kp H     &hm RIGHT_SHIFT J  &hm RCTRL K  &hm RIGHT_ALT L  &hm SEMICOLON SQT
&hm LC(Z) Z  &hm LC(X) X  &hm LC(C) C  &hm LC(V) V       &hm LCTRL B     &hml 3 N  &kp M              &kp COMMA    &kp DOT          &kp SLASH
                          &mo 1        &kp LGUI          &mo 5           &mo 4     &kp RGUI           &mo 1
            >;
        };

        Num_layer {
            display-name = "Num";
            bindings = <
&dj2         &kp F7  &kp F8    &kp F9     &kp LC(LS(ESC))  &trans         &hm LS(N7) N7              &hm LS(N8) N8              &hm LS(N9) N9              &trans
&dj          &kp F4  &kp F5    &kp F6     &trans           &trans         &hm LS(NUMBER_4) NUMBER_4  &hm LS(N5) N5              &hm LS(NUMBER_6) NUMBER_6  &trans
&bootloader  &kp F1  &kp F2    &kp F3     &trans           &hm LS(N0) N0  &hm LS(N1) NUMBER_1        &hm LS(NUMBER_2) NUMBER_2  &hm LS(NUMBER_3) NUMBER_3  &bootloader
                     &kp LALT  &kp LSHFT  &kp LCTRL        &kp RCTRL      &kp RIGHT_SHIFT            &kp RIGHT_ALT
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&kp LEFT_ALT  &mkp MCLK  &mkp RCLK     &mkp LCLK  &trans          &mkp LCLK  &trans  &trans  &trans  &trans
&kp LSHFT     &trans     &trans        &trans     &trans          &trans     &trans  &trans  &trans  &trans
&trans        &trans     &trans        &trans     &kp LCTRL       &trans     &trans  &trans  &trans  &trans
                         &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans     &trans  &trans
            >;
        };

        Scroll_Layrer {
            bindings = <
&dj2    &sleep  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&dj     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Snipe_Layer {
            bindings = <
&trans    &kp UP    &trans     &trans  &trans  &trans    &trans        &trans     &trans  &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans    &kp UP_ARROW  &trans     &trans  &trans
&trans    &trans    &trans     &trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
                    &trans     &trans  &trans  &trans    &trans        &trans
            >;

            label = "Snipe";
        };

        BT_Layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans
&trans        &trans        &bt BT_CLR    &trans        &trans        &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &trans        &trans  &trans  &trans
            >;

            label = "BT";
        };

        arrow {
            bindings = <
&trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &kp UP_ARROW    &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans          &trans           &trans  &trans  &trans  &trans
            >;
        };
    };
};
